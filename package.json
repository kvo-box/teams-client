{
  "name": "teams-client",
  "version": "0.2.2",
  "private": true,
  "description": "Microsoft Teams",
  "homepage": "https://teams.live.com/",
  "author": "lics <lics@localhost>",
  "desktopName": "com.lics.teams-client",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux rpm deb AppImage"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.lics.teams-client",
    "productName": "teams-client",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["rpm", "deb", "AppImage"],
      "category": "InstantMessaging",
      "synopsis": "Microsoft Teams",
      "maintainer": "lics <lics@localhost>",
      "executableName": "teams-client",
      "artifactName": "teams-client-${version}.${arch}.${ext}",
      "syncDesktopName": true,
      "icon": "assets/256x256.png",
      "desktop": {
        "entry": {
          "Name": "teams-client",
          "Comment": "Microsoft Teams",
          "StartupWMClass": "com.lics.teams-client"
        }
      }
    },
    "rpm": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    }
  }
}
